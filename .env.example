# docker compose 环境变量模板。复制为 .env 后修改；.env 已被 .gitignore 忽略。
# cp .env.example .env && docker compose up --build -d

# --- 数据库 ---
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=mini_trello
MYSQL_PORT=3306

# --- 后端 ---
ENVIRONMENT=production
# 生产务必替换为随机密钥（长度 >= 32）：openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me-please-32+
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# 通过 nginx 同源访问时填 web 源；本地直连 API 调试可加 5173
CORS_ORIGINS=http://localhost:8080
# 本地 http 用 false；生产 https 改 true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- 端口映射 ---
API_PORT=8000
WEB_PORT=8080
REDIS_PORT=6379
