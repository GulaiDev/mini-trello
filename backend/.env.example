# 复制为 backend/.env 后按需修改；生产环境通过编排注入，切勿提交真实密钥。
# 注意：.gitignore 已忽略 .env，仅保留本模板。

ENVIRONMENT=development

# 数据库连接串（本地默认指向 127.0.0.1:3306）
DATABASE_URL=mysql+aiomysql://root:123456@localhost:3306/mini_trello?charset=utf8mb4

# JWT 密钥，长度必须 >= 32；生产务必替换为随机值
JWT_SECRET=dev-only-insecure-secret-change-me-please-32+
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# 允许的前端来源（逗号分隔，禁止使用 *）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie：本地 http 用 secure=false；生产 https 应为 true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# 其它
DB_ECHO=false
UPLOAD_DIR=./uploads
